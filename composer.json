{
    "name": "van-ons/filament-content-builder",
    "description": "A Filament package that adds a customizable content builder, complete with a set of frequently used content blocks.",
    "keywords": [
        "laravel",
        "filament",
        "content-builder"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Van Ons",
            "email": "opensource@van-ons.nl"
        }
    ],
    "require": {
        "php": "^8.2",
        "bensampo/laravel-embed": "^3.1.0",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "van-ons/filament-field-library": "^2.0.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.87",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/php-cs-fixer fix",
        "format:check": "vendor/bin/php-cs-fixer check",
        "test": "vendor/bin/pest"
    },
    "autoload": {
        "psr-4": {
            "VanOns\\FilamentContentBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/VanOns/filament-field-library"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "VanOns\\FilamentContentBuilder\\FilamentContentBuilderServiceProvider"
            ],
            "aliases": {
                "FilamentContentBuilder": "VanOns\\FilamentContentBuilder\\Facade\\FilamentContentBuilder"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
