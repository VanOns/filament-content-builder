{
    "name": "van-ons/filament-content-builder",
    "description": "Add a customizable content builder to your Filament admin panel, complete with a set of frequently used content blocks.",
    "keywords": [
        "laravel",
        "filament",
        "content-builder"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "VanOns\\FilamentContentBuilder\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Van Ons",
            "email": "opensource@van-ons.nl"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "van-ons/filament-field-library": "^1.0.0",
        "bensampo/laravel-embed": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "dev-master",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpstan/phpstan": "2.0.x-dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/VanOns/filament-field-library"
        }
    ],
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/php-cs-fixer fix",
        "format:check": "vendor/bin/php-cs-fixer check",
        "test": "vendor/bin/pest"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VanOns\\FilamentContentBuilder\\FilamentContentBuilderServiceProvider"
            ],
            "aliases": {
                "FilamentContentBuilder": "VanOns\\FilamentContentBuilder\\Facade\\FilamentContentBuilder"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
